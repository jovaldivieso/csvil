FROM --platform=linux/amd64 ubuntu:22.04

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive
ENV DB_LACAM_ROOT=/opt/db-lacam
ENV OMPL_PREFIX=/opt/ompl
ENV CMAKE_PREFIX_PATH=/opt/ompl;/opt/openrobots
ENV LD_LIBRARY_PATH=/opt/ompl/lib:/opt/openrobots/lib
ENV VIRTUAL_ENV=/opt/venv  
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

# installs build tools and libraries 
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        ffmpeg \
        git \
        gnupg \
        libeigen3-dev \
        libfcl-dev \
        libgl1 \
        libglib2.0-0 \
        liblz4-dev \
        libmsgpack-dev \
        liboctomap-dev \
        libyaml-cpp-dev \
        pkg-config \
        software-properties-common \
        unzip \
        wget \
    && rm -rf /var/lib/apt/lists/*

# installs Boost 1.78 to match motion-primitives container
ARG BOOST_VERSION=1.78.0
ARG BOOST_VERSION_UNDERSCORE=1_78_0

ENV BOOST_ROOT=/opt/boost
ENV BOOST_INCLUDEDIR=/opt/boost/include
ENV BOOST_LIBRARYDIR=/opt/boost/lib
ENV CMAKE_PREFIX_PATH=/opt/boost;/opt/ompl;/opt/openrobots
ENV LD_LIBRARY_PATH=/opt/boost/lib:/opt/ompl/lib:/opt/openrobots/lib

RUN wget -q \
    "https://archives.boost.io/release/${BOOST_VERSION}/source/boost_${BOOST_VERSION_UNDERSCORE}.tar.gz" \
    -O /tmp/boost.tar.gz \
    && tar -xzf /tmp/boost.tar.gz -C /tmp \
    && cd "/tmp/boost_${BOOST_VERSION_UNDERSCORE}" \
    && ./bootstrap.sh --prefix="${BOOST_ROOT}" \
    && ./b2 install \
        --prefix="${BOOST_ROOT}" \
        variant=release \
        link=shared \
        threading=multi \
        --with-serialization \
        --with-program_options \
        --with-filesystem \
        --with-system \
        --with-stacktrace \
        --with-test \
        -j"$(nproc)" \
    && STACKTRACE_BASIC="$(find bin.v2/libs/stacktrace/build \
        -type f \
        -name "libboost_stacktrace_basic.so.1.78.0" \
        -print -quit)" \
    && test -n "${STACKTRACE_BASIC}" \
    && cp "${STACKTRACE_BASIC}" "${BOOST_ROOT}/lib/" \
    && ln -sf \
        libboost_stacktrace_basic.so.1.78.0 \
        "${BOOST_ROOT}/lib/libboost_stacktrace_basic.so" \
    && test -f "${BOOST_ROOT}/lib/libboost_stacktrace_basic.so.1.78.0" \
    && rm -rf /tmp/boost*
    
# installs python (lerobot 0.5.1 requires python 3.12 or newer):
RUN add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
    && rm -rf /var/lib/apt/lists/*

# adds robotpkg repository and installs crocoddyl and ipopt (required by dynoplan requires during cmake configuration):
RUN echo \
        "deb [arch=amd64] http://robotpkg.openrobots.org/packages/debian/pub jammy robotpkg" \
        > /etc/apt/sources.list.d/robotpkg.list \
    && curl -fsSL \
        http://robotpkg.openrobots.org/packages/debian/robotpkg.key \
        | apt-key add - \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        coinor-libipopt-dev \
        robotpkg-py310-crocoddyl \
    && rm -rf /var/lib/apt/lists/*

# creates python 3.12 virtual environment and installs dependencies:
COPY requirements.txt /tmp/requirements.txt
RUN python3.12 -m venv "${VIRTUAL_ENV}" \
    && python -m pip install --upgrade pip \
    && python -m pip install \
        torch==2.7.1 \
        torchvision==0.22.1 \
        --index-url https://download.pytorch.org/whl/cpu \
    && python -m pip install \
        PyYAML \
        -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

# builds OMPL revision used by db-lacam's CI:
ARG OMPL_REF=e2994e5
RUN git clone https://github.com/ompl/ompl.git /tmp/ompl \
    && cd /tmp/ompl \
    && git checkout "${OMPL_REF}" \
    && /usr/bin/cmake -S . -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX="${OMPL_PREFIX}" \
        -DOMPL_BUILD_PYBIND11_BINDINGS=OFF \
        -DOMPL_BUILD_EXAMPLES=OFF \
        -DOMPL_BUILD_TESTS=OFF \
        -DOMPL_BUILD_CMAKE_CONFIG=ON \
    && /usr/bin/cmake --build build --parallel "$(nproc)" \
    && /usr/bin/cmake --install build \
    && rm -rf /tmp/ompl

COPY db-lacam/ "${DB_LACAM_ROOT}/"

# downloads pregenerated motion primitives used by db-lacam:
RUN cd "${DB_LACAM_ROOT}" \
    && wget -O primitives.zip \
        https://tubcloud.tu-berlin.de/s/wezMej9ieNjwjz6/download \
    && unzip primitives.zip \
    && rm primitives.zip


# - configures project and generates build files in buildRelease
# - compiles build files, building run_dblacam
# (dynobench emits source-code warnings, can be ignored)
ARG DB_LACAM_BUILD_JOBS=1
RUN set -eux; \
    /usr/bin/cmake \
        -S "${DB_LACAM_ROOT}" \
        -B "${DB_LACAM_ROOT}/buildRelease" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_PREFIX_PATH="${CMAKE_PREFIX_PATH}" \
        -DBOOST_ROOT="${BOOST_ROOT}" \
        -DBOOST_INCLUDEDIR="${BOOST_INCLUDEDIR}" \
        -DBOOST_LIBRARYDIR="${BOOST_LIBRARYDIR}" \
        -DBoost_NO_SYSTEM_PATHS=ON; \
    /usr/bin/cmake --build "${DB_LACAM_ROOT}/buildRelease" \
        --target run_dblacam \
        --parallel "${DB_LACAM_BUILD_JOBS}" \
        > /tmp/db-lacam-build.log 2>&1 || { \
            tail -n 150 /tmp/db-lacam-build.log; \
            exit 1; \
        }; \
    test -x "${DB_LACAM_ROOT}/buildRelease/run_dblacam"

WORKDIR /workspace

CMD ["bash"]